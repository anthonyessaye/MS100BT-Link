#!/bin/zsh
# Runs build/zoomprobe.app through LaunchServices so macOS treats the bundle as the app
# using Bluetooth (its Info.plist carries the usage description), and streams its output here.
# Usage: scripts/zoomprobe <command> [args…]   (logs go to ./logs of the current directory)
set -euo pipefail
APP="${0:A:h}/../build/zoomprobe.app"
[[ -d "$APP" ]] || { echo "Run scripts/make-apps.sh first." >&2; exit 1; }

OUT=$(mktemp -t zoomprobe)
trap 'kill $TAIL 2>/dev/null; rm -f "$OUT"' EXIT
tail -f "$OUT" & TAIL=$!
open -W -n --stdout "$OUT" --stderr "$OUT" "$APP" --args "$@" --logs "$PWD/logs"
sleep 0.3
